# Google Cloud Console OAuth 2.0 Client ID for the read-only Google Calendar
# overlay (see src/hooks/useGoogleCalendar.ts). This is a public-facing OAuth
# client ID, not a secret — it's safe to commit and expose client-side (unlike
# an OAuth *client secret*, which this app never uses since it relies on the
# browser-side implicit token flow). Committing it here means both
# `npm run dev` and the GitHub Actions Pages build pick it up automatically,
# with no extra repo-secret configuration needed.
VITE_GOOGLE_CLIENT_ID=981489825457-hijn3m94q6vbnntmk113qeve22uosjrh.apps.googleusercontent.com
